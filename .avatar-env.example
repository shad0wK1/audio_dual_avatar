# Optional overrides sourced by start_avatar.sh.
#
# Single GPU:
#   MINICPM_CUDA_VISIBLE_DEVICES=0
#   MUSETALK_CUDA_VISIBLE_DEVICES=0
#
# Two GPUs:
#   MINICPM_CUDA_VISIBLE_DEVICES=0
#   MUSETALK_CUDA_VISIBLE_DEVICES=1
#
# Both values may also be CUDA UUIDs (GPU-...) instead of numeric indexes.
MINICPM_CUDA_VISIBLE_DEVICES=0
MUSETALK_CUDA_VISIBLE_DEVICES=1

# Keep the native avatar output size. Set a positive width only when a lower
# bandwidth stream is explicitly desired.
AVATAR_STREAM_FORMAT=h264
AVATAR_STREAM_MAX_WIDTH=0
# CPU worker threads for WebP frame encoding. Four threads measured above
# 24fps for the 720p avatar while leaving CPU headroom for inference/blending.
AVATAR_ENCODE_THREADS=4
AVATAR_H264_BITRATE=2M
AVATAR_H264_MAXRATE=3M
AVATAR_H264_BUFSIZE=2M
AVATAR_H264_GOP=48
AVATAR_H264_BACKEND=pyav
AVATAR_H264_CRF=20
AVATAR_H264_PRESET=veryfast
AVATAR_H264_PROFILE=high
AVATAR_H264_LEVEL=4.0
AVATAR_H264_CODEC_STRING=avc1.640028

# The 720p knowledge-sharing avatar is the default. To use the original avatar
# cache as a fallback, uncomment this override.
# MUSETALK_CONFIG=configs/streaming_duplex.yaml
