# Copy to .avatar-env on the server. Select the GPU used by MuseTalk.
MUSETALK_CUDA_VISIBLE_DEVICES=0
AVATAR_STREAM_FORMAT=webp
AVATAR_STREAM_MAX_WIDTH=0
AVATAR_ENCODE_THREADS=4
export AVATAR_H264_CRF=25
export AVATAR_H264_MAX_KBPS=900
# Set a private value and use the same value in the BFF as AVATAR_API_KEY.
export AVATAR_SESSION_API_KEY=
