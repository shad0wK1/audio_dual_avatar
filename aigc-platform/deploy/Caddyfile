{
    admin off
    auto_https off
}
http://:13000 {
    bind 127.0.0.1
    redir /digital-human /digital-human/ 308
    handle_path /digital-human/* {
        reverse_proxy 127.0.0.1:18080
    }
    handle /api/avatar/* {
        reverse_proxy 127.0.0.1:18080
    }
    @accounts path /v1/session /v1/auth/* /v1/credits
    handle @accounts {
        reverse_proxy 127.0.0.1:13002
    }
    @workspaceReads {
        method GET HEAD
        path /v1/*
    }
    handle @workspaceReads {
        reverse_proxy 127.0.0.1:13002
    }
    handle {
        reverse_proxy 127.0.0.1:13001
    }
}
