[Unit]
Description=AIGC platform web frontend
[Service]
WorkingDirectory=%h/audio_dual_avatar/aigc-platform/apps/web/.next/standalone/apps/web
Environment=HOSTNAME=127.0.0.1 PORT=13001 NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
ExecStart=%h/audio_dual_avatar/aigc-platform/.runtime/node/bin/node server.js
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target
