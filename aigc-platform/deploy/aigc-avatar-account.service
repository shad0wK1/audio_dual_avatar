[Unit]
Description=AIGC platform account API
Requires=aigc-avatar-db.service
After=aigc-avatar-db.service
[Service]
WorkingDirectory=/home/user01/audio_dual_avatar/aigc-platform/apps/api
EnvironmentFile=/home/user01/audio_dual_avatar/aigc-platform/.run/account.env
ExecStart=/home/user01/audio_dual_avatar/aigc-platform/.runtime/auth/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 13002 --no-access-log
Restart=on-failure
RestartSec=2
